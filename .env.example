# Copy backend settings to services/api/.env; never expose secrets as NEXT_PUBLIC_*.
DEV_MODE=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
PUBLIC_URL=https://desktop.example.com
SUPABASE_URL=https://PROJECT.supabase.co
ENCRYPTION_KEY=
SIGNING_KEY=
OPS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE=
STRIPE_TOPUP_PRICE=
OPENSANDBOX_DOMAIN=10.0.0.2:8080
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_API_KEY=
DESKTOP_IMAGE=agent-desktop:local
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_DESKTOPS=4
LAUNCH_ENABLED=false
# Trials stay unavailable until every field and a real chain verifier are configured.
TRIAL_ADAPTER_URL=
TRIAL_ADAPTER_KEY=
TRIAL_CHAIN=
TRIAL_TOKEN=
TRIAL_RECIPIENT=
TRIAL_DECIMALS=-1
TRIAL_CREDITS=600
TRIAL_SERVICES={"agent-desktop":600}
ALLOWED_ORIGINS=[]
# Frontend only: apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_MODE=false
API_INTERNAL_URL=http://127.0.0.1:8000
# Leave unset behind the production reverse proxy.
NEXT_PUBLIC_WS_URL=
# Shared prepaid crypto billing. Leave disabled until a complete test payment passes.
X402_ENABLED=false
X402_NETWORK=eip155:84532
X402_ASSET=
X402_PAY_TO=
X402_RPC_URL=
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=
X402_TOKEN_NAME=USDC
X402_TOKEN_VERSION=2
X402_CONFIRMATIONS=3
X402_MAX_TIMEOUT_SECONDS=300
# Provisional local price: 0.003334 USDC / desktop minute. Review before launch.
CUBICLE_MINUTE_MICRO_USDC=3334
PLATFORM_SERVICE_PRICES={}
# Private backend-to-backend keys; never expose to frontend.
PLATFORM_SERVICE_TOKENS={}
# X402_FACILITATOR_PRIVATE_KEY belongs ONLY in the separate facilitator process.
